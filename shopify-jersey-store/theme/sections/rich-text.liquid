<section class="section page-width center">
  {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading }}</h2>{%- endif -%}
  <div class="rte narrow">{{ section.settings.text }}</div>
  {%- if section.settings.button_label != blank -%}
    <a href="{{ section.settings.button_link }}" class="button">{{ section.settings.button_label }}</a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "טקסט",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת" },
    { "type": "richtext", "id": "text", "label": "טקסט" },
    { "type": "text", "id": "button_label", "label": "כפתור" },
    { "type": "url", "id": "button_link", "label": "קישור" }
  ],
  "presets": [{ "name": "טקסט" }]
}
{% endschema %}
