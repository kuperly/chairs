{%- assign menu = section.settings.menu -%}
<header class="header{% if section.settings.sticky %} header--sticky{% endif %}">
  <div class="header__inner page-width">
    <button type="button" class="icon-button header__menu-toggle" data-mobile-menu-toggle aria-controls="MobileMenu" aria-expanded="false" aria-label="{{ 'general.menu' | t }}">
      {% render 'icon', icon: 'menu' %}
    </button>

    <a href="{{ routes.root_url }}" class="header__logo">
      {%- if section.settings.logo != blank -%}
        {%- capture logo_style %}max-width: {{ section.settings.logo_width }}px{% endcapture -%}
        {{
          section.settings.logo
          | image_url: width: 400
          | image_tag: alt: shop.name, style: logo_style, widths: '200, 400', loading: 'eager'
        }}
      {%- else -%}
        <span class="header__logo-text">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    <nav class="header__nav" aria-label="{{ 'general.main_menu' | t }}">
      <ul class="nav" role="list">
        {%- for link in menu.links -%}
          <li class="nav__item{% if link.links.size > 0 %} nav__item--has-children{% endif %}">
            <a href="{{ link.url }}" class="nav__link{% if link.child_active or link.active %} is-active{% endif %}">
              {{ link.title }}
              {%- if link.links.size > 0 %}{% render 'icon', icon: 'chevron' %}{% endif -%}
            </a>
            {%- if link.links.size > 0 -%}
              <div class="mega">
                <div class="mega__inner page-width">
                  {%- for child in link.links -%}
                    <div class="mega__col">
                      <a href="{{ child.url }}" class="mega__heading">{{ child.title }}</a>
                      {%- if child.links.size > 0 -%}
                        <ul role="list">
                          {%- for grandchild in child.links -%}
                            <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header__icons">
      <button type="button" class="icon-button" data-search-toggle aria-label="{{ 'general.search' | t }}">
        {% render 'icon', icon: 'search' %}
      </button>
      {%- if shop.customer_accounts_enabled -%}
        <a href="{{ routes.account_url }}" class="icon-button" aria-label="{{ 'general.account' | t }}">
          {% render 'icon', icon: 'account' %}
        </a>
      {%- endif -%}
      <a href="{{ routes.cart_url }}" class="icon-button header__cart" data-cart-toggle aria-label="{{ 'cart.title' | t }}">
        {% render 'icon', icon: 'cart' %}
        <span class="header__cart-count{% if cart.item_count == 0 %} is-hidden{% endif %}" data-cart-count>{{ cart.item_count }}</span>
      </a>
    </div>
  </div>

  <div class="search-bar" data-search-bar hidden>
    <form action="{{ routes.search_url }}" method="get" role="search" class="page-width search-bar__form">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <input type="search" name="q" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'general.search' | t }}" autocomplete="off">
      <button type="submit" class="button">{{ 'general.search' | t }}</button>
    </form>
  </div>

  <div id="MobileMenu" class="mobile-menu" hidden>
    <ul role="list">
      {%- for link in menu.links -%}
        <li>
          {%- if link.links.size > 0 -%}
            <details>
              <summary>{{ link.title }} {% render 'icon', icon: 'chevron' %}</summary>
              <ul role="list">
                <li><a href="{{ link.url }}">{{ 'general.view_all' | t }}</a></li>
                {%- for child in link.links -%}
                  <li>
                    {%- if child.links.size > 0 -%}
                      <details>
                        <summary>{{ child.title }} {% render 'icon', icon: 'chevron' %}</summary>
                        <ul role="list">
                          <li><a href="{{ child.url }}">{{ 'general.view_all' | t }}</a></li>
                          {%- for grandchild in child.links -%}
                            <li><a href="{{ grandchild.url }}">{{ grandchild.title }}</a></li>
                          {%- endfor -%}
                        </ul>
                      </details>
                    {%- else -%}
                      <a href="{{ child.url }}">{{ child.title }}</a>
                    {%- endif -%}
                  </li>
                {%- endfor -%}
              </ul>
            </details>
          {%- else -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</header>

{% schema %}
{
  "name": "כותרת עליונה",
  "class": "section-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "לוגו" },
    { "type": "range", "id": "logo_width", "label": "רוחב לוגו", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "link_list", "id": "menu", "label": "תפריט ראשי", "default": "main-menu" },
    { "type": "checkbox", "id": "sticky", "label": "כותרת דביקה בגלילה", "default": true }
  ]
}
{% endschema %}
