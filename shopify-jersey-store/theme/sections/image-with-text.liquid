<section class="section page-width">
  <div class="split{% if section.settings.image_last %} split--reverse{% endif %}">
    <div class="split__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '600, 900, 1200', sizes: '(min-width: 750px) 50vw, 100vw' }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}
    </div>
    <div class="split__content">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <div class="rte">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="button">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "תמונה עם טקסט",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "תמונה" },
    { "type": "checkbox", "id": "image_last", "label": "תמונה בצד השני", "default": false },
    { "type": "text", "id": "eyebrow", "label": "כותרת קטנה", "default": "מהדורה מוגבלת" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "החולצה שכולם מחפשים" },
    { "type": "richtext", "id": "text", "label": "טקסט", "default": "<p>כמות מוגבלת במלאי. כולל אפשרות להדפסת שם, מספר ופאץ'.</p>" },
    { "type": "text", "id": "button_label", "label": "כפתור", "default": "לרכישה" },
    { "type": "url", "id": "button_link", "label": "קישור" }
  ],
  "presets": [{ "name": "תמונה עם טקסט" }]
}
{% endschema %}
