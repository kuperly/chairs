{%- assign collection = section.settings.collection -%}
<section class="section page-width">
  <div class="section__header">
    <h2 class="h2">{{ section.settings.heading | default: collection.title }}</h2>
    {%- if collection != blank and section.settings.show_view_all -%}
      <a href="{{ collection.url }}" class="link">{{ 'general.view_all' | t }}</a>
    {%- endif -%}
  </div>

  <div class="{% if section.settings.layout == 'slider' %}slider{% else %}grid grid--{{ section.settings.columns }}{% endif %}">
    {%- if collection != blank and collection.products_count > 0 -%}
      {%- for product in collection.products limit: section.settings.limit -%}
        {% render 'product-card', product: product %}
      {%- endfor -%}
    {%- else -%}
      {%- for i in (1..4) -%}
        <article class="card">
          <div class="card__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}</div>
          <div class="card__info"><h3 class="card__title">{{ 'products.placeholder_title' | t }}</h3><div class="price">₪249</div></div>
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "קולקציה מוצגת",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת" },
    { "type": "collection", "id": "collection", "label": "קולקציה" },
    { "type": "range", "id": "limit", "label": "כמות מוצרים", "min": 2, "max": 16, "step": 1, "default": 8 },
    { "type": "select", "id": "columns", "label": "עמודות בדסקטופ", "options": [
      { "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }
    ], "default": "4" },
    { "type": "select", "id": "layout", "label": "תצוגה", "options": [
      { "value": "grid", "label": "גריד" }, { "value": "slider", "label": "סליידר נגלל" }
    ], "default": "slider" },
    { "type": "checkbox", "id": "show_view_all", "label": "קישור 'לכל המוצרים'", "default": true }
  ],
  "presets": [{ "name": "קולקציה מוצגת" }]
}
{% endschema %}
