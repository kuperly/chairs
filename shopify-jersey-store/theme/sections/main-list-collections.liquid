<section class="section page-width">
  <h1 class="h1 center">{{ 'collections.all_collections' | t }}</h1>
  <div class="tiles tiles--card">
    {%- for collection in collections -%}
      <a href="{{ collection.url }}" class="tile">
        <div class="tile__media">
          {%- if collection.featured_image -%}
            {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        <span class="tile__title">{{ collection.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{ "name": "כל הקולקציות" }
{% endschema %}
