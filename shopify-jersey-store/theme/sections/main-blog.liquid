<section class="section page-width">
  <h1 class="h1 center">{{ blog.title }}</h1>
  {%- paginate blog.articles by 12 -%}
    <div class="grid grid--3">
      {%- for article in blog.articles -%}
        <article class="card">
          <a href="{{ article.url }}" class="card__link">
            {%- if article.image -%}
              <div class="card__media">{{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', class: 'card__img' }}</div>
            {%- endif -%}
            <div class="card__info">
              <h2 class="card__title">{{ article.title }}</h2>
              <p class="small muted">{{ article.published_at | time_tag: format: 'date' }}</p>
            </div>
          </a>
        </article>
      {%- endfor -%}
    </div>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>

{% schema %}
{ "name": "בלוג" }
{% endschema %}
