<section class="section page-width">
  <h1 class="h1 center">{{ 'search.title' | t }}</h1>
  <form action="{{ routes.search_url }}" method="get" role="search" class="player-search__form narrow">
    <input type="hidden" name="type" value="product">
    <input type="hidden" name="options[prefix]" value="last">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'general.search' | t }}">
    <button type="submit" class="button">{{ 'general.search' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      <p class="center muted">{{ 'search.results_for' | t: terms: search.terms, count: search.results_count }}</p>
      {%- if search.filters.size > 0 -%}
        {% render 'facets', results: search, url: routes.search_url, terms: search.terms %}
      {%- endif -%}
      {%- if search.results_count > 0 -%}
        <div class="grid grid--4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <article class="card card--text"><a href="{{ item.url }}" class="card__title">{{ item.title }}</a></article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p class="center section">{{ 'search.no_results' | t }}</p>
      {%- endif -%}
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "תוצאות חיפוש" }
{% endschema %}
