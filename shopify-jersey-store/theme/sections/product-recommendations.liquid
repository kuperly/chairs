<product-recommendations class="section page-width" data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}">
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <div class="section__header"><h2 class="h2">{{ section.settings.heading }}</h2></div>
    <div class="slider">
      {%- for rec in recommendations.products -%}
        {% render 'product-card', product: rec %}
      {%- endfor -%}
    </div>
  {%- endif -%}
</product-recommendations>

{% schema %}
{
  "name": "המלצות מוצרים",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "אולי תאהבו גם" },
    { "type": "range", "id": "limit", "label": "כמות", "min": 2, "max": 10, "step": 1, "default": 8 }
  ]
}
{% endschema %}
