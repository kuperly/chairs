<section class="hero" style="--hero-overlay: {{ section.settings.overlay | divided_by: 100.0 }}; --hero-height: {{ section.settings.height }}vh;">
  <div class="hero__media">
    {%- if section.settings.image != blank -%}
      {%- if section.settings.image_mobile != blank -%}
        {{ section.settings.image_mobile | image_url: width: 900 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hero__img hero__img--mobile', sizes: '100vw', widths: '450, 900' }}
      {%- endif -%}
      {{ section.settings.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', class: 'hero__img', sizes: '100vw', widths: '800, 1200, 1800, 2400' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder hero__img' }}
    {%- endif -%}
  </div>
  <div class="hero__content page-width hero__content--{{ section.settings.alignment }}">
    {%- if section.settings.rating_text != blank -%}
      <p class="hero__rating">
        {%- for i in (1..5) -%}{% render 'icon', icon: 'star' %}{%- endfor -%}
        <span>{{ section.settings.rating_text }}</span>
      </p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="hero__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- assign shop_all_url = routes.collections_url | append: '/shop-all' -%}
    <div class="hero__buttons">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: shop_all_url }}" class="button button--large">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a href="{{ section.settings.button2_link | default: shop_all_url }}" class="button button--large button--ghost">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "באנר ראשי",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "תמונה (דסקטופ)" },
    { "type": "image_picker", "id": "image_mobile", "label": "תמונה (מובייל)" },
    { "type": "range", "id": "height", "label": "גובה", "min": 40, "max": 100, "step": 5, "unit": "vh", "default": 75 },
    { "type": "range", "id": "overlay", "label": "הכהיית תמונה", "min": 0, "max": 80, "step": 5, "unit": "%", "default": 35 },
    { "type": "select", "id": "alignment", "label": "יישור תוכן", "options": [
      { "value": "start", "label": "התחלה" }, { "value": "center", "label": "מרכז" }, { "value": "end", "label": "סוף" }
    ], "default": "center" },
    { "type": "text", "id": "rating_text", "label": "שורת דירוג", "default": "4.9 מתוך 5 · מעל 1,000 ביקורות" },
    { "type": "text", "id": "heading", "label": "כותרת", "default": "החולצה של הקבוצה שלך. עם השם שלך." },
    { "type": "richtext", "id": "text", "label": "טקסט", "default": "<p>חולצות כדורגל וכדורסל לעונה החדשה, רטרו וילדים · הדפסת שם ומספר</p>" },
    { "type": "text", "id": "button_label", "label": "כפתור 1", "default": "לכל החולצות" },
    { "type": "url", "id": "button_link", "label": "קישור כפתור 1" },
    { "type": "text", "id": "button2_label", "label": "כפתור 2", "default": "מונדיאל 2026" },
    { "type": "url", "id": "button2_link", "label": "קישור כפתור 2" }
  ],
  "presets": [{ "name": "באנר ראשי" }]
}
{% endschema %}
