<cart-drawer id="CartDrawer" class="drawer" aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="{{ 'cart.title' | t }}" tabindex="-1">
    <div class="drawer__header">
      <h2 class="h4">{{ 'cart.title' | t }} ({{ cart.item_count }})</h2>
      <button type="button" class="icon-button" data-drawer-close aria-label="{{ 'general.close' | t }}">
        {% render 'icon', icon: 'close' %}
      </button>
    </div>

    {%- if section.settings.free_shipping_threshold > 0 -%}
      {%- liquid
        assign threshold = section.settings.free_shipping_threshold | times: 100
        assign remaining = threshold | minus: cart.total_price
        assign progress = cart.total_price | times: 100 | divided_by: threshold
        if progress > 100
          assign progress = 100
        endif
      -%}
      <div class="shipping-progress">
        {%- if remaining > 0 -%}
          <p>{{ 'cart.free_shipping_remaining' | t: amount: remaining | money }}</p>
        {%- else -%}
          <p>{{ 'cart.free_shipping_unlocked' | t }}</p>
        {%- endif -%}
        <div class="shipping-progress__bar"><span style="width: {{ progress }}%"></span></div>
      </div>
    {%- endif -%}

    <div class="drawer__body">
      {%- if cart.item_count > 0 -%}
        <ul class="cart-lines" role="list">
          {%- for item in cart.items -%}
            {% render 'cart-line', item: item %}
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="cart-empty">
          <p>{{ 'cart.empty' | t }}</p>
          <a href="{{ routes.collections_url | append: '/shop-all' }}" class="button">{{ 'cart.continue_shopping' | t }}</a>
        </div>
      {%- endif -%}
    </div>

    {%- if cart.item_count > 0 -%}
      <div class="drawer__footer">
        {%- for discount in cart.cart_level_discount_applications -%}
          <p class="cart-line__discount">{{ discount.title }} (-{{ discount.total_allocated_amount | money }})</p>
        {%- endfor -%}
        <div class="cart-total">
          <span>{{ 'cart.subtotal' | t }}</span>
          <strong>{{ cart.total_price | money_with_currency }}</strong>
        </div>
        <p class="small muted">{{ 'cart.taxes_and_shipping' | t }}</p>
        <form action="{{ routes.cart_url }}" method="post">
          <button type="submit" name="checkout" class="button button--full">{{ 'cart.checkout' | t }}</button>
        </form>
        <a href="{{ routes.cart_url }}" class="link center">{{ 'cart.view_cart' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</cart-drawer>

{% schema %}
{
  "name": "עגלה צדדית",
  "settings": [
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "סף משלוח חינם (₪)",
      "info": "0 = ללא פס התקדמות. חייב להתאים להגדרות המשלוח באדמין.",
      "default": 299
    }
  ]
}
{% endschema %}
