<section class="section page-width">
  {%- if section.settings.heading != blank -%}
    <div class="section__header"><h2 class="h2">{{ section.settings.heading }}</h2></div>
  {%- endif -%}
  <div class="tiles tiles--{{ section.settings.style }}">
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- assign tile_image = block.settings.image | default: c.featured_image -%}
      <a href="{{ c.url | default: '#' }}" class="tile" {{ block.shopify_attributes }}>
        <div class="tile__media">
          {%- if tile_image != blank -%}
            {{ tile_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', sizes: '(min-width: 990px) 16vw, 33vw', alt: c.title }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
          {%- endif -%}
        </div>
        <span class="tile__title">{{ block.settings.title | default: c.title }}</span>
      </a>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "אריחי קטגוריות",
  "max_blocks": 18,
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "קנו לפי ליגה" },
    { "type": "select", "id": "style", "label": "סגנון", "options": [
      { "value": "circle", "label": "עיגולים (סמלי קבוצות)" },
      { "value": "card", "label": "כרטיסים" }
    ], "default": "circle" }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "קולקציה",
      "settings": [
        { "type": "collection", "id": "collection", "label": "קולקציה" },
        { "type": "text", "id": "title", "label": "כותרת (אופציונלי)" },
        { "type": "image_picker", "id": "image", "label": "תמונה (אופציונלי)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "אריחי קטגוריות",
      "blocks": [
        { "type": "collection" }, { "type": "collection" }, { "type": "collection" },
        { "type": "collection" }, { "type": "collection" }, { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
