<section class="section section--surface">
  <div class="page-width">
    <div class="section__header">
      <h2 class="h2">{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p class="muted">{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="slider">
      {%- for block in section.blocks -%}
        <figure class="review" {{ block.shopify_attributes }}>
          <div class="review__stars" aria-label="{{ block.settings.rating }}/5">
            {%- for i in (1..block.settings.rating) -%}{% render 'icon', icon: 'star' %}{%- endfor -%}
          </div>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', class: 'review__img', alt: block.settings.author }}
          {%- endif -%}
          <blockquote>{{ block.settings.text }}</blockquote>
          <figcaption>— {{ block.settings.author }}</figcaption>
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "ביקורות לקוחות",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "מה הלקוחות אומרים" },
    { "type": "text", "id": "subheading", "label": "תת כותרת" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "ביקורת",
      "settings": [
        { "type": "range", "id": "rating", "label": "כוכבים", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "text", "label": "טקסט" },
        { "type": "text", "id": "author", "label": "שם הלקוח" },
        { "type": "image_picker", "id": "image", "label": "תמונת לקוח (אופציונלי)" }
      ]
    }
  ],
  "presets": [{ "name": "ביקורות לקוחות", "blocks": [{ "type": "review" }, { "type": "review" }, { "type": "review" }] }]
}
{% endschema %}
