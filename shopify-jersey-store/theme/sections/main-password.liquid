<section class="section page-width center password">
  <h1 class="h1">{{ shop.name }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}

  {%- form 'customer', class: 'newsletter narrow' -%}
    <input type="hidden" name="contact[tags]" value="prelaunch">
    {%- if form.posted_successfully? -%}
      <p class="form-success">{{ 'newsletter.success' | t }}</p>
    {%- else -%}
      <div class="newsletter__row">
        <input type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}" aria-label="{{ 'newsletter.email' | t }}">
        <button type="submit" class="button">{{ 'newsletter.notify_me' | t }}</button>
      </div>
    {%- endif -%}
  {%- endform -%}

  <details class="password__login narrow">
    <summary class="link">{{ 'password.enter_with_password' | t }}</summary>
    {%- form 'storefront_password' -%}
      <div class="newsletter__row">
        <input type="password" name="password" required placeholder="{{ 'password.password' | t }}" aria-label="{{ 'password.password' | t }}">
        <button type="submit" class="button">{{ 'password.enter' | t }}</button>
      </div>
      {{ form.errors | default_errors }}
    {%- endform -%}
  </details>
</section>

{% schema %}
{ "name": "עמוד סיסמה" }
{% endschema %}
