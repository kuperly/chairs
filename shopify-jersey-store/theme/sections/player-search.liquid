<section class="section page-width">
  <div class="player-search">
    <h2 class="h2">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="muted">{{ section.settings.text }}</p>{%- endif -%}
    <form action="{{ routes.search_url }}" method="get" role="search" class="player-search__form">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
      <input type="search" name="q" required placeholder="{{ section.settings.placeholder }}" aria-label="{{ section.settings.placeholder }}">
      <button type="submit" class="button">{% render 'icon', icon: 'search' %} {{ 'general.search' | t }}</button>
    </form>
    {%- if section.blocks.size > 0 -%}
      <div class="chips">
        {%- for block in section.blocks -%}
          <a class="chip" href="{{ routes.search_url }}?type=product&q={{ block.settings.term | url_encode }}" {{ block.shopify_attributes }}>{{ block.settings.term }}</a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "חיפוש שחקן / קבוצה",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "מחפשים שחקן או קבוצה?" },
    { "type": "text", "id": "text", "label": "טקסט", "default": "הקלידו שם שחקן, קבוצה או נבחרת" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "למשל: מסי, ריאל מדריד, לייקרס" }
  ],
  "blocks": [
    { "type": "term", "name": "חיפוש פופולרי", "settings": [{ "type": "text", "id": "term", "label": "מונח", "default": "ברצלונה" }] }
  ],
  "presets": [{ "name": "חיפוש שחקן / קבוצה" }]
}
{% endschema %}
