<section class="section page-width">
  <div class="narrow center">
    <h1 class="h1">{{ section.settings.heading }}</h1>
    <div class="rte">{{ section.settings.text }}</div>
  </div>

  <div class="narrow">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when '@app' -%}
          {% render block %}
      {%- endcase -%}
    {%- endfor -%}

    {%- if section.blocks.size == 0 -%}
      <div class="tracking-card">
        <p>{{ 'tracking.with_account' | t }}</p>
        <a href="{{ routes.account_url }}" class="button button--full">{{ 'tracking.my_orders' | t }}</a>
        <p class="small muted">{{ 'tracking.email_hint' | t }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "מעקב הזמנה",
  "settings": [
    { "type": "text", "id": "heading", "label": "כותרת", "default": "מעקב אחר הזמנה" },
    { "type": "richtext", "id": "text", "label": "טקסט", "default": "<p>זמן אספקה משוער: 7–14 ימי עסקים. ברגע שההזמנה נשלחת תקבלו מייל/SMS עם מספר מעקב.</p>" }
  ],
  "blocks": [{ "type": "@app" }]
}
{% endschema %}
