{%- comment -%}
  Usage: {% render 'product-card', product: product %}
{%- endcomment -%}
<article class="card">
  <a href="{{ product.url }}" class="card__link">
    <div class="card__media">
      {%- if product.featured_media -%}
        {{
          product.featured_media
          | image_url: width: 600
          | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw', alt: product.featured_media.alt, class: 'card__img'
        }}
        {%- if product.media[1] -%}
          {{
            product.media[1]
            | image_url: width: 600
            | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 25vw, 50vw', alt: '', class: 'card__img card__img--hover'
          }}
        {%- endif -%}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder' }}
      {%- endif -%}

      <div class="card__badges">
        {%- unless product.available -%}
          <span class="badge badge--muted">{{ 'products.sold_out' | t }}</span>
        {%- endunless -%}
        {%- if product.compare_at_price > product.price and product.available -%}
          <span class="badge badge--sale">{{ 'products.sale' | t }}</span>
        {%- endif -%}
        {%- if product.tags contains 'new' -%}
          <span class="badge">{{ 'products.new' | t }}</span>
        {%- endif -%}
        {%- if product.tags contains 'personalizable' -%}
          <span class="badge badge--outline">{{ 'products.personalizable' | t }}</span>
        {%- endif -%}
      </div>
    </div>
    <div class="card__info">
      {%- if product.vendor != blank -%}
        <p class="card__vendor">{{ product.vendor }}</p>
      {%- endif -%}
      <h3 class="card__title">{{ product.title }}</h3>
      {% render 'price', product: product %}
    </div>
  </a>
</article>
