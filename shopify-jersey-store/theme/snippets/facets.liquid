{%- comment -%}
  Storefront filters (configured in the "Search & Discovery" app) + sorting.
  Usage: {% render 'facets', results: collection, url: collection.url %}
         {% render 'facets', results: search, url: routes.search_url, terms: search.terms %}
{%- endcomment -%}
<facet-form class="facets">
  <form action="{{ url }}" method="get" data-facet-form>
    {%- if terms -%}
      <input type="hidden" name="q" value="{{ terms | escape }}">
      <input type="hidden" name="type" value="product">
      <input type="hidden" name="options[prefix]" value="last">
    {%- endif -%}

    <div class="facets__bar">
      <button type="button" class="button button--ghost facets__toggle" data-facets-toggle>{{ 'collections.filter' | t }}</button>
      <label class="facets__sort">
        <span>{{ 'collections.sort_by' | t }}</span>
        <select name="sort_by" data-auto-submit>
          {%- assign sort_by = results.sort_by | default: results.default_sort_by -%}
          {%- for option in results.sort_options -%}
            <option value="{{ option.value | escape }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name | escape }}</option>
          {%- endfor -%}
        </select>
      </label>
      <span class="muted small">{{ 'collections.product_count' | t: count: results.products_count }}</span>
    </div>

    <div class="facets__panel" data-facets-panel>
      {%- for filter in results.filters -%}
        <details class="accordion facets__group" {% if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value %}open{% endif %}>
          <summary>{{ filter.label | escape }} {% render 'icon', icon: 'chevron' %}</summary>
          {%- case filter.type -%}
            {%- when 'list', 'boolean' -%}
              <ul role="list" class="facets__list{% if filter.presentation == 'swatch' %} facets__list--pills{% endif %}">
                {%- for value in filter.values -%}
                  <li>
                    <label class="checkbox{% if value.count == 0 and value.active == false %} is-disabled{% endif %}">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" data-auto-submit
                        {% if value.active %}checked{% endif %}
                        {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                      <span>{{ value.label | escape }} <span class="muted">({{ value.count }})</span></span>
                    </label>
                  </li>
                {%- endfor -%}
              </ul>
            {%- when 'price_range' -%}
              <div class="facets__price">
                <input type="number" name="{{ filter.min_value.param_name }}" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}"
                  placeholder="0" {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | remove: ',' }}"{% endif %} aria-label="{{ 'collections.price_from' | t }}">
                <span>–</span>
                <input type="number" name="{{ filter.max_value.param_name }}" min="0" max="{{ filter.range_max | money_without_currency | remove: ',' }}"
                  placeholder="{{ filter.range_max | money_without_currency | remove: ',' }}" {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | remove: ',' }}"{% endif %} aria-label="{{ 'collections.price_to' | t }}">
                <button type="submit" class="button button--small">{{ 'collections.apply' | t }}</button>
              </div>
          {%- endcase -%}
        </details>
      {%- endfor -%}
    </div>
  </form>

  {%- liquid
    assign has_active = false
    for filter in results.filters
      if filter.active_values.size > 0 or filter.min_value.value or filter.max_value.value
        assign has_active = true
      endif
    endfor
  -%}
  {%- if has_active -%}
    <div class="chips facets__active">
      {%- for filter in results.filters -%}
        {%- for value in filter.active_values -%}
          <a class="chip chip--active" href="{{ value.url_to_remove }}">{{ value.label | escape }} ✕</a>
        {%- endfor -%}
        {%- if filter.type == 'price_range' -%}
          {%- if filter.min_value.value or filter.max_value.value -%}
            <a class="chip chip--active" href="{{ filter.url_to_remove }}">
              {{ filter.min_value.value | default: 0 | money }} – {{ filter.max_value.value | default: filter.range_max | money }} ✕
            </a>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      <a class="link" href="{{ url }}{% if terms %}?q={{ terms | url_encode }}&type=product{% endif %}">{{ 'collections.clear_all' | t }}</a>
    </div>
  {%- endif -%}
</facet-form>
