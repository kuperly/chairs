{%- comment -%}
  Renders one cart line. Used by the cart drawer and the cart page.
  Usage: {% render 'cart-line', item: item, index: forloop.index %}
{%- endcomment -%}
<li class="cart-line{% if item.properties._linked_to != blank %} cart-line--addon{% endif %}" data-line-key="{{ item.key }}">
  <a href="{{ item.url }}" class="cart-line__media">
    {%- if item.image -%}
      {{ item.image | image_url: width: 160 | image_tag: loading: 'lazy', alt: item.title }}
    {%- endif -%}
  </a>
  <div class="cart-line__info">
    <a href="{{ item.url }}" class="cart-line__title">{{ item.product.title }}</a>
    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-line__meta">{{ item.variant.title }}</p>
    {%- endunless -%}
    {%- for property in item.properties -%}
      {%- assign first_char = property.first | slice: 0 -%}
      {%- if property.last != blank and first_char != '_' -%}
        <p class="cart-line__meta">{{ property.first }}: {{ property.last }}</p>
      {%- endif -%}
    {%- endfor -%}
    <div class="cart-line__price">
      {%- if item.original_line_price > item.final_line_price -%}
        <s>{{ item.original_line_price | money }}</s>
      {%- endif -%}
      {{ item.final_line_price | money }}
    </div>
    {%- for discount in item.line_level_discount_allocations -%}
      <p class="cart-line__discount">{{ discount.discount_application.title }} (-{{ discount.amount | money }})</p>
    {%- endfor -%}
  </div>
  <div class="cart-line__qty">
    {%- if item.properties._linked_to == blank -%}
      <quantity-input class="qty">
        <button type="button" data-qty-change="-1" aria-label="{{ 'cart.decrease' | t }}">−</button>
        <input type="number" min="0" value="{{ item.quantity }}" data-line-qty aria-label="{{ 'cart.quantity' | t }}">
        <button type="button" data-qty-change="1" aria-label="{{ 'cart.increase' | t }}">+</button>
      </quantity-input>
      <button type="button" class="link cart-line__remove" data-line-remove>{{ 'cart.remove' | t }}</button>
    {%- else -%}
      <span class="cart-line__qty-static">× {{ item.quantity }}</span>
    {%- endif -%}
  </div>
</li>
