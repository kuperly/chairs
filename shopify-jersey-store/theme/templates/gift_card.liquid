{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}" dir="rtl">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>
  <body>
    <main class="section page-width center gift-card">
      <h1 class="h1">{{ shop.name }}</h1>
      <p>{{ 'gift_card.title' | t }}</p>
      <p class="h1">{{ gift_card.balance | money }}</p>
      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="form-error">{{ 'gift_card.expired' | t }}</p>
      {%- endif -%}
      <p class="gift-card__code">{{ gift_card.code | format_code }}</p>
      <div id="QrCode" data-identifier="{{ gift_card.qr_identifier }}"></div>
      <script>
        window.addEventListener('load', function () {
          var el = document.getElementById('QrCode');
          if (window.QRCode) new QRCode(el, { text: el.dataset.identifier, width: 120, height: 120 });
        });
      </script>
      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Apple Wallet" loading="lazy"></a>
      {%- endif -%}
      <p><button type="button" class="button" onclick="window.print()">{{ 'gift_card.print' | t }}</button>
      <a href="{{ shop.url }}" class="button button--ghost">{{ 'gift_card.shop' | t }}</a></p>
    </main>
  </body>
</html>
